            .url = "git+https://github.com/dazzleos/dazzle#b849c27ba7a42b26161675b38017609125c90f8e",
            .hash = "dazzle-0.0.0-ze61II-6sQCIouWz-n5OXDNZ959YL-SYHDBMSrLAsjXk",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
    },
}
