.{
    .name = .text_editor,
    .version = "0.0.0",
    .fingerprint = 0xd97d6849f7ebb322, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // Dazzle's modules (kete_vc4 and the rest) and tools, which
